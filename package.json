{
  "name": "tools",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "bench"
    ],
    "catalog": {
      "typescript": "6.0.3",
      "zod": "4.6.7",
      "@types/bun": "1.4.4",
      "vite": "8.3.7"
    }
  },
  "scripts": {
    "dev": "bun run --filter @tools/web dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "check:host": "bun scripts/check-host.ts",
    "prepare": "git config core.hooksPath .githooks",
    "verify": "bun fmt --check && bun run check:host && bun audit --audit-level=high && bun run typecheck && bun test && bun run build",
    "e2e": "bun run --filter @tools/web e2e",
    "bench": "bun run --filter @tools/bench bench"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
