---
import { absoluteUrl } from "@tools/site";
import { REPO_URL } from "../lib/links";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Site path, e.g. "/compress-image"; used for canonical and og:url. */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
const fullTitle = path === "/" ? title : `${title} · Tools`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-dvh flex-col text-base antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2">
      Skip to content
    </a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-sm font-semibold text-text no-underline">
          <img src="/icon.svg" alt="" width="24" height="24" />
          Tools
        </a>
        <nav aria-label="Main">
          <a href="/compress-image" class="text-sm text-muted no-underline hover:text-text">Compress image</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-sm text-muted">
        <p>Files never leave your device. No uploads, no tracking.</p>
        <a href={REPO_URL} class="text-muted">Source on GitHub</a>
      </div>
    </footer>
  </body>
</html>
