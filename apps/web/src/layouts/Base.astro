---
import { absoluteUrl } from "@tools/seo";
import Smartphone from "lucide-react/icons/smartphone";
import { Lockup } from "../components/brand/Mark";
import { NEW_ISSUE_URL, REPO_URL } from "../lib/links";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Site path, e.g. "/compress-image"; used for canonical and og:url. */
  path: string;
  noindex?: boolean;
  /** Which main nav item this page belongs to. */
  section?: "forms" | "image";
}

const { title, description, path, noindex = false, section } = Astro.props;
const canonical = absoluteUrl(path);
const fullTitle = path === "/" ? title : `${title} · Tools by Bhimraj`;
const nav = [
  { id: "forms", href: "/#forms", label: "Forms" },
  { id: "image", href: "/compress-image", label: "Image" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tools by Bhimraj" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-dvh flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:z-10 focus:rounded-lg focus:bg-card focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <header class="border-b border-line bg-card">
      <div class="mx-auto flex min-h-[60px] w-full max-w-[1120px] items-center gap-3 px-4 md:min-h-[68px] md:gap-5 md:px-8">
        <Lockup href="/" className="text-xl md:text-[21px]" />
        <nav aria-label="Main" class="ml-auto flex gap-0.5 md:ml-0 md:mr-auto">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={section === n.id ? "page" : undefined}
                class="inline-flex min-h-11 items-center rounded-sm px-2.5 text-[15px] font-medium text-ink-2 no-underline aria-[current=page]:rounded-none aria-[current=page]:text-ink aria-[current=page]:shadow-[inset_0_-2px_0_var(--color-accent)]"
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <p class="hidden items-center gap-1.5 text-[13px] font-[550] text-ink-2 md:inline-flex">
          <Smartphone aria-hidden="true" className="size-4 text-accent-ink" strokeWidth={2} />
          0 files uploaded
          <span class="sr-only">. Your files stay on this device.</span>
        </p>
      </div>
    </header>
    <main id="main" class="flex-1 pt-4 pb-10 md:pt-6 md:pb-16">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-8">
        <slot />
      </div>
    </main>
    <footer class="border-t border-line bg-card">
      <div class="mx-auto grid w-full max-w-[1120px] grid-cols-2 gap-x-4 gap-y-5 px-4 py-6 text-sm md:grid-cols-5 md:px-8">
        <div>
          <h2 class="mb-1.5 text-[13px] font-[650]">Forms</h2>
          <a href="/#forms" class="block py-2.5 text-ink-2 no-underline md:py-[3px]">All forms</a>
        </div>
        <div>
          <h2 class="mb-1.5 text-[13px] font-[650]">Image</h2>
          <a href="/compress-image" class="block py-2.5 text-ink-2 no-underline md:py-[3px]">Compress to KB</a>
        </div>
        <div>
          <h2 class="mb-1.5 text-[13px] font-[650]">About</h2>
          <a href={NEW_ISSUE_URL} rel="noopener noreferrer external" class="block py-2.5 text-ink-2 no-underline md:py-[3px]">
            Report a different size rule
          </a>
          <a href={REPO_URL} rel="noopener noreferrer external" class="block py-2.5 text-ink-2 no-underline md:py-[3px]">
            Source code
          </a>
        </div>
      </div>
      <div class="on-band border-t border-band-edge">
        <div class="mx-auto flex w-full max-w-[1120px] flex-wrap items-center gap-x-6 gap-y-3 px-4 py-5 md:px-8">
          <Lockup className="text-[22px]" />
          <p class="max-w-[52ch] text-sm">
            Photos and signatures at the exact size your form asks for. Free, and your files stay on your device.
          </p>
          <p class="inline-flex items-center gap-1.5 text-[13px] font-semibold md:ml-auto">
            <Smartphone aria-hidden="true" className="size-4" strokeWidth={2} />
            0 files uploaded
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
