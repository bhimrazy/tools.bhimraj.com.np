---
import type { Preset } from "@tools/presets";
import { dimensions, sizeRange } from "../lib/presets";
import SpecBadge from "./SpecBadge.astro";

interface Props {
  preset: Preset;
}
const { preset } = Astro.props;
const dims = dimensions(preset);
---

<a href={`/${preset.path}`} class="card flex h-full flex-col gap-3 p-4">
  <span class="grid gap-0.5">
    <span class="font-medium">{preset.title}</span>
    <span class="text-sm text-muted">{preset.portal}</span>
  </span>
  <span class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-t border-border pt-3">
    <span class="text-sm font-medium tabular-nums">{[dims, sizeRange(preset)].filter(Boolean).join(" · ")}</span>
    <SpecBadge verifiedAt={preset.verifiedAt} />
  </span>
</a>
