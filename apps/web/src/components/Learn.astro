---
interface Props {
  steps: string[];
  faq: [question: string, answer: string][];
}
const { steps, faq } = Astro.props;
---

<div class="mt-10 grid gap-8 border-t border-line pt-8 md:grid-cols-2">
  <section aria-labelledby="how-h">
    <h2 id="how-h" class="t-h2">How it works</h2>
    <ol class="mt-3 grid gap-2.5">
      {
        steps.map((s, i) => (
          <li class="grid grid-cols-[28px_minmax(0,1fr)] gap-2.5 text-[15px] text-ink-2">
            <span
              class="grid size-[26px] place-items-center rounded-full border-[1.5px] border-line-strong text-[13px] font-[650] text-ink"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <span>{s}</span>
          </li>
        ))
      }
    </ol>
  </section>
  <section aria-labelledby="faq-h">
    <h2 id="faq-h" class="t-h2">Questions</h2>
    <div class="mt-2 border-t border-line">
      {
        faq.map(([q, a]) => (
          <details class="border-b border-line">
            <summary class="cursor-pointer py-3 text-[15px] font-semibold">{q}</summary>
            <p class="pb-3 text-[15px] text-ink-2">{a}</p>
          </details>
        ))
      }
    </div>
  </section>
</div>
