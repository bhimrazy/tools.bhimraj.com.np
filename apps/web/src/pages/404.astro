---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist." path="/404" noindex>
  <div class="grid gap-4 py-8">
    <span class="badge badge-neutral w-fit font-mono">404</span>
    <h1 class="text-3xl tracking-tight">Page not found</h1>
    <p class="text-muted">The link may be old, or the form preset may have moved.</p>
    <p><a href="/" class="btn-primary">Browse all tools</a></p>
  </div>
</Base>
