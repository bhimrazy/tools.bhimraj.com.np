---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist." path="/404" noindex>
  <div class="grid gap-4 py-8">
    <p class="font-mono text-sm text-faint">Error 404</p>
    <h1 class="text-3xl">Page not found</h1>
    <p class="max-w-prose text-muted">The link may be out of date, or the form preset may have moved.</p>
    <p class="flex flex-wrap gap-3 pt-2">
      <a href="/" class="btn-primary">Browse all tools</a>
      <a href="/compress-image" class="btn-secondary">Compress an image</a>
    </p>
  </div>
</Base>
