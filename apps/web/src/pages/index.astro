---
import { presets } from "@tools/presets";
import PresetCard from "../components/PresetCard.astro";
import Base from "../layouts/Base.astro";
import { countryName, groupByCountry } from "../lib/presets";

const groups = groupByCountry(presets);
---

<Base
  title="Tools: form-ready photos and image compression, on your device"
  description="Resize and compress photos and signatures to exact exam and visa form specs, or to any size in KB. Private by design: files never leave your device."
  path="/"
>
  <section class="grid gap-4 pb-8 sm:pb-12">
    <span class="badge badge-neutral w-fit">Private by design</span>
    <h1 class="text-3xl tracking-tight sm:text-4xl">Form-ready photos, made on your device.</h1>
    <p class="max-w-prose text-lg text-muted">
      Files never leave your device. Pick a form below, add your photo, and download a file that meets the exact
      size and KB limit, even on a slow connection.
    </p>
  </section>

  <section aria-labelledby="tools-heading" class="grid gap-4 pb-10">
    <h2 id="tools-heading" class="text-lg">Tools</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      <li>
        <a href="/compress-image" class="card grid h-full gap-1 p-4">
          <span class="font-medium">Compress image to a size in KB</span>
          <span class="text-sm text-muted">Any photo to under 20, 50, 100 KB or whatever the form asks, with optional width and height.</span>
        </a>
      </li>
    </ul>
  </section>

  {
    groups.length > 0 && (
      <section aria-labelledby="forms-heading" class="grid gap-6">
        <div class="grid gap-1">
          <h2 id="forms-heading" class="text-lg">Exam, job and visa forms</h2>
          <p class="text-sm text-muted">Presets set the pixel size, KB limit and background for you.</p>
        </div>
        {groups.map(([country, list]) => (
          <section aria-labelledby={`c-${country}`} class="grid gap-3">
            <h3 id={`c-${country}`} class="flex items-center gap-3 text-xs font-medium tracking-wide text-muted uppercase">
              {countryName(country)}
              <span class="h-px flex-1 bg-border" aria-hidden="true" />
            </h3>
            <ul class="grid gap-3 sm:grid-cols-2">
              {list.map((preset) => (
                <li>
                  <PresetCard preset={preset} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    )
  }
</Base>
