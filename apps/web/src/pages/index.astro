---
// Devanagari and Bengali faces: the browser fetches a file only when its script appears (unicode-range).
import "@fontsource-variable/noto-sans-devanagari/wght.css";
import "@fontsource-variable/noto-sans-bengali/wght.css";
import { groupByCountry } from "@tools/presets";
import FileCheck from "lucide-react/icons/file-check";
import ImageUp from "lucide-react/icons/image-up";
import Shrink from "lucide-react/icons/shrink";
import Smartphone from "lucide-react/icons/smartphone";
import PresetRow from "../components/PresetRow.astro";
import { cn } from "cn";
import { buttonVariants } from "../components/ui/button";
import Base from "../layouts/Base.astro";
import { countryName, getNativeCountry, sortByCountryName } from "../lib/format";

const groups = sortByCountryName(groupByCountry());
---

<Base
  title="Tools: form-ready photos and image compression, on your device"
  description="Resize and compress photos and signatures to exam and visa form size rules, or to any size in KB. Your files stay on your device."
  path="/"
>
  <div class="grid gap-5 md:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] md:items-start md:gap-8 md:pt-4">
    <div>
      <h1 class="t-hero">Make your photo or signature the right size for any form.</h1>
      <p class="mt-2 max-w-[52ch] text-[15px] text-ink-2 md:text-[17px]">
        Free. Works in your browser. Your files never leave your phone or computer.
      </p>
    </div>
    <aside class="on-band grid justify-items-start gap-3 rounded-xl p-5 md:mt-1.5 md:p-6" aria-labelledby="drop-h">
      <ImageUp aria-hidden="true" className="size-6" strokeWidth={1.75} />
      <h2 id="drop-h" class="t-h3">Compress an image to a size in KB</h2>
      <p class="text-sm text-on-band-muted">Set the limit, add your image, and download a file under it.</p>
      <a href="/compress-image" class={cn(buttonVariants({ variant: "inverse" }))}>Compress an image</a>
      <p class="flex items-center gap-1.5 text-[13px] text-on-band-muted">
        <Smartphone aria-hidden="true" className="size-4 text-on-band" strokeWidth={2} />
        Your file stays on this device.
      </p>
    </aside>
  </div>

  <div class="mt-10 grid gap-y-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:gap-x-10">
    <section id="forms" aria-labelledby="forms-h">
      <div class="mb-3 flex items-baseline justify-between gap-3">
        <h2 id="forms-h" class="t-h2">Forms</h2>
        <p class="text-[13px] text-muted-foreground">Each one shows where its size rule came from.</p>
      </div>
      {
        groups.map(([country, list]) => {
          const native = getNativeCountry(country);
          return (
            <section aria-labelledby={`c-${country}`} class="mt-5 first-of-type:mt-0">
              <div class="flex items-baseline gap-2.5 pb-1.5">
                <h3 id={`c-${country}`} class="text-lg font-[680] tracking-[-0.01em]">
                  {countryName(country)}
                </h3>
                {native && (
                  <span class:list={["text-[15px] text-muted-foreground", native.script]} lang={native.lang}>
                    {native.name}
                  </span>
                )}
                <span class="num ml-auto text-[13px] text-muted-foreground">
                  {list.length} {list.length === 1 ? "form" : "forms"}
                </span>
              </div>
              <div class="border-t border-line">
                {list.map((preset) => (
                  <PresetRow preset={preset} />
                ))}
              </div>
            </section>
          );
        })
      }
    </section>

    <section aria-labelledby="tools-h">
      <h2 id="tools-h" class="t-h2 mb-3">All tools</h2>
      <h3 class="t-h3 border-b border-line pb-2">Image tools</h3>
      <ul>
        <li>
          <a
            href="/compress-image"
            class="flex min-h-11 items-center gap-2.5 border-b border-line py-2 text-[15px] text-ink no-underline"
          >
            <Shrink aria-hidden="true" className="size-5 text-ink-2" strokeWidth={1.75} />
            Compress to KB
          </a>
        </li>
      </ul>
    </section>
  </div>

  <section class="mt-8 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-card p-4 md:p-5">
    <div>
      <h2 class="t-h3">Can't find your form?</h2>
      <p class="mt-1 text-[13px] text-muted-foreground">Enter the size rule from your notice.</p>
    </div>
    <a href="/compress-image" class={cn(buttonVariants({ variant: "outline" }))}>Enter your own size rule</a>
  </section>

  <section aria-labelledby="priv-h" class="mt-10 md:border-t md:border-line md:pt-6">
    <h2 id="priv-h" class="t-h2">How we keep your files private</h2>
    <ul class="my-4 grid gap-4 md:grid-cols-3 md:gap-6">
      <li class="grid grid-cols-[28px_minmax(0,1fr)] items-start gap-3 text-[15px] text-ink-2">
        <Smartphone aria-hidden="true" className="size-6 text-accent-ink" strokeWidth={1.75} />
        <p>Your files never leave this device. Every tool runs in your browser.</p>
      </li>
      <li class="grid grid-cols-[28px_minmax(0,1fr)] items-start gap-3 text-[15px] text-ink-2">
        <FileCheck aria-hidden="true" className="size-6 text-accent-ink" strokeWidth={1.75} />
        <p>Each form shows where its size rule came from, and when we checked it.</p>
      </li>
    </ul>
  </section>
</Base>
