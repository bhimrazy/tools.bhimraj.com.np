---
import { presets } from "@tools/presets";
import { IconArrowRight, IconCheck, IconLock } from "../components/icons";
import PresetCard from "../components/PresetCard.astro";
import Base from "../layouts/Base.astro";
import { countryName, groupByCountry } from "../lib/presets";

const groups = groupByCountry(presets);
---

<Base
  title="Tools: form-ready photos and image compression, on your device"
  description="Resize and compress photos and signatures to exact exam and visa form specs, or to any size in KB. Private by design: files never leave your device."
  path="/"
>
  <section class="grid gap-4 pb-10 sm:pb-14">
    <h1 class="text-3xl sm:text-4xl">Form-ready photos and signatures, made on your device.</h1>
    <p class="max-w-prose text-lg text-muted">
      Pick your form, add a photo, and download a file that meets its exact pixel size and KB limit.
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
      <li class="flex items-center gap-2"><IconLock class="text-text" /> Files never leave your device</li>
      <li class="flex items-center gap-2"><IconCheck class="text-text" /> Each spec is marked verified or unverified</li>
    </ul>
  </section>

  <section aria-labelledby="tools-heading" class="grid gap-3 pb-10">
    <h2 id="tools-heading" class="text-lg">Tools</h2>
    <a href="/compress-image" class="card group flex items-center justify-between gap-4 p-4">
      <span class="grid gap-0.5">
        <span class="font-medium">Compress an image to a size in KB</span>
        <span class="text-sm text-muted">Any photo to 20, 50, 100 KB or whatever the form asks, with an optional exact width and height.</span>
      </span>
      <IconArrowRight class="text-faint group-hover:text-text" />
    </a>
  </section>

  {
    groups.length > 0 && (
      <section aria-labelledby="forms-heading" class="grid gap-6">
        <div class="grid gap-1">
          <h2 id="forms-heading" class="text-lg">Exam, job and visa forms</h2>
          <p class="text-sm text-muted">Each preset sets the pixel size, KB limit and background for you.</p>
        </div>
        {groups.map(([country, list]) => (
          <section aria-labelledby={`c-${country}`} class="grid gap-3">
            <h3 id={`c-${country}`} class="flex items-center gap-3 text-xs font-medium tracking-wider text-muted uppercase">
              {countryName(country)}
              <span class="h-px flex-1 bg-border" aria-hidden="true" />
            </h3>
            <ul class="grid gap-3 sm:grid-cols-2">
              {list.map((preset) => (
                <li>
                  <PresetCard preset={preset} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    )
  }
</Base>
