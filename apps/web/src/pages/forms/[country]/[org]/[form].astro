---
// Devanagari and Bengali faces: the browser fetches a file only when its script appears (unicode-range).
import "@fontsource-variable/noto-sans-devanagari/wght.css";
import "@fontsource-variable/noto-sans-bengali/wght.css";
import { formPath, groupByForm, maxBytesToKb, toCompressOptions, uploadPath, type Preset } from "@tools/presets";
import { reportRuleUrl } from "@tools/site";
import type { GetStaticPaths } from "astro";
import { StatusGlyph } from "../../../../components/brand/StatusGlyph";
import CompressIsland from "../../../../components/CompressIsland.astro";
import Base from "../../../../layouts/Base.astro";
import {
  countryName,
  FORMAT_LABEL,
  formatByteRange,
  formatChecked,
  formatDate,
  formatDimensions,
  formatSizeRule,
  getNativeCountry,
} from "../../../../lib/format";

// One page per form; each upload it asks for is a section, linked as #{upload}.
export const getStaticPaths = (() =>
  [...groupByForm().values()].map((uploads) => {
    const { country, org, form } = uploads[0]!;
    return { params: { country: country.toLowerCase(), org, form }, props: { uploads } };
  })) satisfies GetStaticPaths;

interface Props {
  uploads: Preset[];
}

const { uploads } = Astro.props;
const first = uploads[0]!;
const path = formPath(first);
const portalName = first.portal.replace(/\s*\(.*\)$/, "");
const native = getNativeCountry(first.country);

const sections = uploads.map((preset) => {
  const { rule } = preset;
  const dims = formatDimensions(rule);
  const size = formatByteRange(rule);
  const bg = rule.background && (/^#f{3}(f{3})?$/i.test(rule.background) ? "white" : rule.background);
  const facts: [string, string][] = [
    ...(dims ? [["Width and height", dims] as [string, string]] : []),
    ["File size", size],
    ["Format", FORMAT_LABEL[rule.format]],
    ...(bg ? [["Background", bg] as [string, string]] : []),
  ];
  return { preset, rule, dims, size, bg, facts, options: toCompressOptions(rule) };
});

const description = `Make your ${first.formTitle} ${sections
  .map(({ preset, dims, size }) => `${preset.kind} (${[dims, size].filter(Boolean).join(", ")})`)
  .join(" and ")}, ready to upload to ${portalName}. It runs on your device, so nothing is uploaded.`;
---

<Base title={first.formTitle} {description} path={path} section="forms">
  <nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap gap-1.5 text-[13px] text-muted-foreground">
    <a href="/" class="text-muted-foreground no-underline">Home</a><span aria-hidden="true">/</span>
    <a href="/#forms" class="text-muted-foreground no-underline">Forms</a><span aria-hidden="true">/</span>
    <span>
      {countryName(first.country)}{" "}
      {native && <span class={native.script} lang={native.lang}>{native.name}</span>}
    </span>
  </nav>
  <h1 class="t-h1">{first.formTitle}</h1>
  <p class="mt-2 flex flex-wrap gap-x-2.5 gap-y-1 text-[13px] text-muted-foreground">
    <span>For {portalName}</span><span aria-hidden="true">·</span><span>Your files stay on this device</span>
  </p>
  {
    sections.length > 1 && (
      <nav aria-label="Uploads on this page" class="mt-4 flex flex-wrap gap-1.5">
        {sections.map(({ preset }) => (
          <a
            href={`#${preset.upload}`}
            class="inline-flex min-h-11 items-center rounded-full border border-input bg-card px-3.5 text-sm font-[520] text-ink no-underline hover:bg-muted sm:min-h-10"
          >
            {preset.kind.charAt(0).toUpperCase() + preset.kind.slice(1)}
          </a>
        ))}
      </nav>
    )
  }

  {
    sections.map(({ preset, rule, dims, size, bg, facts, options }) => (
      <section
        id={preset.upload}
        aria-labelledby={`${preset.upload}-heading`}
        class="mt-8 scroll-mt-4 border-t border-line pt-6 first-of-type:border-t-0 md:mt-10"
      >
        <h2 id={`${preset.upload}-heading`} class="t-h2">
          {preset.title}
        </h2>
        <p class="num mt-1 mb-4 flex flex-wrap gap-x-2.5 gap-y-1 text-[13px] text-muted-foreground md:mb-5">
          <span translate="no">{formatSizeRule(rule)}</span>
          <span aria-hidden="true">·</span>
          <span class:list={[preset.verifiedAt && "text-ink"]}>{formatChecked(preset)}</span>
        </p>

        {preset.verifiedAt === null && (
          <p class="mb-4 flex items-start gap-2.5 rounded-lg bg-sunk px-3.5 py-3 text-sm md:mb-5">
            <StatusGlyph status="unv" className="mt-px size-5 shrink-0 text-status-warn" />
            <span>
              <b>Not checked yet.</b> These numbers come from{" "}
              {preset.source ? preset.source.label.toLowerCase() : "no source we could confirm"}. Check your notice
              before you submit.
            </span>
          </p>
        )}

        {options ? (
          <CompressIsland rule={options} kind={preset.kind} id={preset.upload} verified={preset.verifiedAt !== null} />
        ) : (
          <p class="rounded-xl border border-line bg-card p-4">
            {FORMAT_LABEL[rule.format]} files can't be made here yet. Use the size rule below with the{" "}
            <a href="/compress-image">image compressor</a>.
          </p>
        )}

        <div class="mt-8 grid items-start gap-8 md:grid-cols-2">
          <div
            role="group"
            aria-labelledby={`${preset.upload}-rule-heading`}
            class="rounded-xl border border-line bg-card p-4 md:p-5"
          >
            <h3 id={`${preset.upload}-rule-heading`} class="t-h3">
              Size rule
            </h3>
            <dl class="mt-2 text-sm">
              {facts.map(([k, v]) => (
                <div class="flex justify-between gap-4 border-b border-line py-2 last:border-b-0">
                  <dt class="text-muted-foreground">{k}</dt>
                  <dd class:list={["num text-right", k === "Background" && "capitalize"]} translate="no">
                    {v}
                  </dd>
                </div>
              ))}
            </dl>
            <div class="mt-2 grid gap-1 border-t border-line pt-3 text-[13px] text-muted-foreground">
              <p>
                Source:{" "}
                {preset.source ? (
                  <a href={preset.source.url} rel="noopener noreferrer external">
                    {preset.source.label}
                  </a>
                ) : (
                  "none we could confirm yet."
                )}
              </p>
              <p>
                {preset.verifiedAt
                  ? `Checked ${formatDate(preset.verifiedAt)}.`
                  : "Not checked against an official notice yet."}
              </p>
              <a
                class="inline-flex min-h-11 items-center text-sm font-[550]"
                href={reportRuleUrl(preset.title, uploadPath(preset))}
                rel="noopener noreferrer external"
              >
                Report a different rule
              </a>
            </div>
          </div>
          <div class="grid gap-3">
            <h3 class="t-h3">About this {preset.kind}</h3>
            {preset.notes && <p class="text-[15px] text-ink-2">{preset.notes}</p>}
            <p class="text-[15px] text-ink-2">
              Add your {preset.kind} and it is{" "}
              {rule.fit === "contain"
                ? `fitted inside ${dims ?? "the size the form asks for"} without cutting anything off`
                : `cropped from the centre to ${dims ?? "the size the form asks for"}`}
              {bg && `, on a ${bg} background,`} and made{" "}
              {rule.minBytes === undefined ? `${maxBytesToKb(rule.maxBytes)} KB or less` : size}. Your browser does
              all of it, so the file never leaves your device.
            </p>
            <p class="text-[13px] text-muted-foreground">
              Tip: crop your {preset.kind} roughly to shape first, so nothing that matters is lost.
            </p>
          </div>
        </div>
      </section>
    ))
  }
</Base>
