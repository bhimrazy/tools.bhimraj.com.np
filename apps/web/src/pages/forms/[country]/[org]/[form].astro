---
import { formPath, groupByForm, maxBytesToKb, toCompressOptions, uploadPath, type Preset } from "@tools/presets";
import { reportRuleUrl } from "@tools/site";
import type { GetStaticPaths } from "astro";
import CompressIsland from "../../../../components/CompressIsland.astro";
import Base from "../../../../layouts/Base.astro";
import { countryName, FORMAT_LABEL, formatByteRange, formatDate, formatDimensions } from "../../../../lib/format";

// One page per form; each upload it asks for is a section, linked as #{upload}.
export const getStaticPaths = (() =>
  [...groupByForm().values()].map((uploads) => {
    const { country, org, form } = uploads[0]!;
    return { params: { country: country.toLowerCase(), org, form }, props: { uploads } };
  })) satisfies GetStaticPaths;

interface Props {
  uploads: Preset[];
}

const { uploads } = Astro.props;
const first = uploads[0]!;
const path = formPath(first);
const portalName = first.portal.replace(/\s*\(.*\)$/, "");

const sections = uploads.map((preset) => {
  const { rule } = preset;
  const dims = formatDimensions(rule);
  const size = formatByteRange(rule);
  const bg = rule.background && (/^#f{3}(f{3})?$/i.test(rule.background) ? "white" : rule.background);
  return { preset, rule, dims, size, bg, options: toCompressOptions(rule) };
});

const description = `Make your ${first.formTitle} ${sections
  .map(({ preset, dims, size }) => `${preset.kind} (${[dims, size].filter(Boolean).join(", ")})`)
  .join(" and ")}, ready to upload to ${portalName}. Runs on your device; nothing is uploaded.`;
---

<Base title={first.formTitle} {description} path={path}>
  <nav aria-label="Breadcrumb" class="pb-3 text-sm text-muted">
    <a href="/">Tools</a> <span aria-hidden="true">/</span> {countryName(first.country)}
  </nav>
  <div class="grid gap-2 pb-5">
    <h1 class="text-2xl tracking-tight sm:text-3xl">{first.formTitle}</h1>
    <p class="text-muted">For {first.portal}.</p>
    {
      sections.length > 1 && (
        <nav aria-label="Uploads on this page" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {sections.map(({ preset }) => (
            <a href={`#${preset.upload}`}>{preset.title}</a>
          ))}
        </nav>
      )
    }
  </div>

  {
    sections.map(({ preset, rule, dims, size, bg, options }) => (
      <section id={preset.upload} aria-labelledby={`${preset.upload}-heading`} class="grid gap-4 pt-8">
        <div class="grid gap-1">
          <h2 id={`${preset.upload}-heading`} class="text-xl tracking-tight">
            {preset.title}
          </h2>
          {preset.verifiedAt === null ? (
            <p class="flex flex-wrap items-center gap-2 text-sm">
              <span class="badge badge-warning">Not checked yet</span>
              <span class="text-muted">Check the official notice before you submit.</span>
            </p>
          ) : (
            <p class="flex flex-wrap items-center gap-2 text-sm">
              <span class="badge badge-success">Checked {formatDate(preset.verifiedAt)}</span>
            </p>
          )}
        </div>

        {options ? (
          <CompressIsland rule={options} kind={preset.kind} id={preset.upload} />
        ) : (
          <p class="card p-4">
            {FORMAT_LABEL[rule.format]} output isn't supported yet. Use the size rule below with the{" "}
            <a href="/compress-image">image compressor</a>.
          </p>
        )}

        <div role="group" aria-labelledby={`${preset.upload}-rule-heading`} class="card mt-6 grid gap-3 p-4 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 id={`${preset.upload}-rule-heading`} class="text-lg">
              Size rule
            </h3>
            <span class="font-mono text-xs text-muted">{preset.id}</span>
          </div>
          <dl class="facts text-sm">
            {dims && (
              <div>
                <dt>Size</dt>
                <dd>{dims}</dd>
              </div>
            )}
            <div>
              <dt>File size</dt>
              <dd>{size}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>{FORMAT_LABEL[rule.format]}</dd>
            </div>
            {bg && (
              <div>
                <dt>Background</dt>
                <dd class="capitalize">{bg}</dd>
              </div>
            )}
          </dl>
          <div class="grid gap-1 border-t border-border pt-3 text-muted text-sm">
            {preset.source ? (
              <p>
                Source:{" "}
                <a href={preset.source.url} rel="noopener noreferrer external">
                  {preset.source.label}
                </a>
              </p>
            ) : (
              <p>Source: none we could confirm yet.</p>
            )}
            <p>
              {preset.verifiedAt
                ? `Checked ${formatDate(preset.verifiedAt)}.`
                : "Not checked against an official notice yet."}{" "}
              <a href={reportRuleUrl(preset.title, uploadPath(preset))} rel="noopener noreferrer external">
                Report a different rule
              </a>
            </p>
          </div>
        </div>

        <div class="mt-4 grid max-w-prose gap-3">
          <h3 class="text-lg">About this {preset.kind}</h3>
          {preset.notes && <p>{preset.notes}</p>}
          <p>
            Pick your {preset.kind} and it is cropped from the centre to {dims ?? "the required size"}
            {bg && `, placed on a ${bg} background,`} and compressed to{" "}
            {rule.minBytes === undefined ? `${maxBytesToKb(rule.maxBytes)} KB or less` : size}. Everything runs in your
            browser, so the file never leaves your device.
          </p>
          <p class="text-sm text-muted">
            Tip: crop your {preset.kind} roughly to shape first so the centre crop keeps what matters.
          </p>
        </div>
      </section>
    ))
  }
</Base>
