---
// Devanagari and Bengali faces: the browser fetches a file only when its script appears (unicode-range).
import "@fontsource-variable/noto-sans-devanagari/wght.css";
import "@fontsource-variable/noto-sans-bengali/wght.css";
import { formPath, groupByForm, toCompressOptions, uploadPath, type Preset } from "@tools/presets";
import { reportRuleUrl } from "@tools/site";
import type { GetStaticPaths } from "astro";
import { StatusGlyph } from "../../../../components/brand/StatusGlyph";
import FormKitIsland from "../../../../components/FormKitIsland.astro";
import Base from "../../../../layouts/Base.astro";
import {
  countryName,
  FORMAT_LABEL,
  formatByteRange,
  formatDate,
  formatDimensions,
  getNativeCountry,
} from "../../../../lib/format";

// One page per form; each upload it asks for is a section, linked as #{upload}.
export const getStaticPaths = (() =>
  [...groupByForm().values()].map((uploads) => {
    const { country, org, form } = uploads[0]!;
    return { params: { country: country.toLowerCase(), org, form }, props: { uploads } };
  })) satisfies GetStaticPaths;

interface Props {
  uploads: Preset[];
}

const { uploads } = Astro.props;
const first = uploads[0]!;
const path = formPath(first);
const portalName = first.portal.replace(/\s*\(.*\)$/, "");
const native = getNativeCountry(first.country);
const local = first.formLocalName;
const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const sections = uploads.map((preset) => {
  const { rule } = preset;
  const dims = formatDimensions(rule);
  const size = formatByteRange(rule);
  const bg = rule.background && (/^#f{3}(f{3})?$/i.test(rule.background) ? "white" : rule.background);
  const facts: [string, string][] = [
    ...(dims ? [["Width and height", dims] as [string, string]] : []),
    ["File size", size],
    ["Format", FORMAT_LABEL[rule.format]],
    ...(bg ? [["Background", bg] as [string, string]] : []),
  ];
  return { preset, rule, dims, size, bg, facts, options: toCompressOptions(rule) };
});

const kitUploads = sections.map(({ preset, rule, dims, size, bg }) => ({
  upload: preset.upload,
  kind: preset.kind,
  label: capitalise(preset.kind),
  rule: toCompressOptions(rule),
  ruleText: [dims, size, FORMAT_LABEL[rule.format].replace(/ \(.*\)$/, ""), bg && `${bg} background`]
    .filter(Boolean)
    .join(" · "),
  verified: preset.verifiedAt !== null,
}));

const description = `Make your ${first.formTitle} ${sections
  .map(({ preset, dims, size }) => `${preset.kind} (${[dims, size].filter(Boolean).join(", ")})`)
  .join(" and ")}, ready to upload to ${portalName}. It runs on your device, so nothing is uploaded.`;
---

<Base title={first.formTitle} {description} path={path} section="forms">
  <nav aria-label="Breadcrumb" class="-mt-3 mb-0.5 flex flex-wrap items-center gap-1.5 text-[13px] text-muted-foreground">
    <a href="/#forms" class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-ink hover:underline">Forms</a
    ><span aria-hidden="true">/</span>
    <span>
      {countryName(first.country)}{" "}
      {native && <span class={native.script} lang={native.lang}>{native.name}</span>}
    </span><span aria-hidden="true">/</span>
    <span>{portalName}</span>
  </nav>
  <h1 class="t-h1">{first.formTitle}</h1>
  {
    local && (
      <p class:list={["mt-1 text-[15px] text-ink-2", local.lang === "bn" ? "beng" : "deva"]} lang={local.lang}>
        {local.text}
      </p>
    )
  }
  <p class="mt-2 mb-5 max-w-[64ch] text-[15px] text-ink-2 md:mb-6 md:text-[17px]">
    Make every file the {first.formTitle} asks for. Each one is checked against its size rule before you download.
    Your files stay on this device.
  </p>

  <FormKitIsland
    id={first.form}
    path={path}
    formTitle={first.formTitle}
    uploads={kitUploads}
    reportUrl={reportRuleUrl(first.formTitle, path)}
    sourceLabel={first.source?.label ?? null}
  />

  <section aria-labelledby="rules-h" class="mt-12 border-t border-line pt-8">
    <h2 id="rules-h" class="t-h2">Where these size rules come from</h2>
    <div class:list={["mt-4 grid items-start gap-4", sections.length > 1 && "md:grid-cols-2"]}>
      {
        sections.map(({ preset, facts }) => (
          <div
            role="group"
            aria-labelledby={`${preset.upload}-rule-heading`}
            class="rounded-xl border border-line bg-card p-4 md:p-5"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 id={`${preset.upload}-rule-heading`} class="t-h3">
                {capitalise(preset.kind)}
              </h3>
              {preset.verifiedAt ? (
                <span class="text-[13px] font-semibold">Checked {formatDate(preset.verifiedAt)}</span>
              ) : (
                <span class="st rounded-full bg-sunk px-2.5 py-1 text-status-warn">
                  <StatusGlyph status="unv" />
                  Not checked yet
                </span>
              )}
            </div>
            <dl class="mt-2 text-sm">
              {facts.map(([k, v]) => (
                <div class="flex justify-between gap-4 border-b border-line py-2 last:border-b-0">
                  <dt class="text-muted-foreground">{k}</dt>
                  <dd class:list={["num text-right", k === "Background" && "capitalize"]} translate="no">
                    {v}
                  </dd>
                </div>
              ))}
            </dl>
            <div class="mt-2 grid gap-1 border-t border-line pt-3 text-[13px] text-muted-foreground">
              <p>
                Source:{" "}
                {preset.source ? (
                  <a href={preset.source.url} rel="noopener noreferrer external">
                    {preset.source.label}
                  </a>
                ) : (
                  "none we could confirm yet."
                )}
              </p>
              <p>
                {preset.verifiedAt
                  ? `Checked ${formatDate(preset.verifiedAt)}.`
                  : "Not checked against an official notice yet."}
              </p>
              {preset.notes && <p class="text-ink-2">{preset.notes}</p>}
              <a
                class="inline-flex min-h-11 items-center text-sm font-[550]"
                href={reportRuleUrl(preset.title, uploadPath(preset))}
                rel="noopener noreferrer external"
              >
                Report a different rule
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-4 max-w-[70ch] text-[13px] text-muted-foreground">
      {sections.some((x) => x.rule.fit === "cover") && "A photo is cropped from the centre to its exact size. "}
      {sections.some((x) => x.rule.fit === "contain") &&
        "A signature or scan is fitted inside its size on the background colour, so nothing is cut off. "}
      Your browser does all of it, so nothing is uploaded. Tip: crop roughly to shape first, so nothing that matters is
      lost.
    </p>
  </section>
</Base>
