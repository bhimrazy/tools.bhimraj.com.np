---
import { maxBytesToKb, presets, toCompressOptions, type Preset } from "@tools/presets";
import type { GetStaticPaths } from "astro";
import CompressIsland from "../components/CompressIsland.astro";
import Base from "../layouts/Base.astro";
import { reportRuleUrl } from "@tools/site";
import { countryName, FORMAT_LABEL, formatByteRange, formatDate, formatDimensions } from "../lib/format";

export const getStaticPaths = (() =>
  presets.map((preset) => ({ params: { path: preset.path }, props: { preset } }))) satisfies GetStaticPaths;

interface Props {
  preset: Preset;
}

const { preset } = Astro.props;
const { rule } = preset;
const dims = formatDimensions(rule);
const size = formatByteRange(rule);
const path = `/${preset.path}`;
const bg = rule.background && (/^#f{3}(f{3})?$/i.test(rule.background) ? "white" : rule.background);

const options = toCompressOptions(rule);

const description = `Make your ${preset.title.toLowerCase()}: ${[dims, size].filter(Boolean).join(", ")}, ready to upload to ${preset.portal.replace(/\s*\(.*\)$/, "")}. Runs on your device; nothing is uploaded.`;
---

<Base title={preset.title} {description} path={path}>
  <nav aria-label="Breadcrumb" class="pb-3 text-sm text-muted">
    <a href="/">Tools</a> <span aria-hidden="true">/</span> {countryName(preset.country)}
  </nav>
  <div class="grid gap-2 pb-5">
    <h1 class="text-2xl tracking-tight sm:text-3xl">{preset.title}</h1>
    <p class="text-muted">For {preset.portal}.</p>
    {
      preset.verifiedAt === null ? (
        <p class="mt-1 flex flex-wrap items-center gap-2 text-sm">
          <span class="badge badge-warning">Unverified</span>
          <span class="text-muted">Check the official notice before you submit.</span>
        </p>
      ) : (
        <p class="mt-1 flex flex-wrap items-center gap-2 text-sm">
          <span class="badge badge-success">Verified</span>
          <span class="text-muted">Last verified {formatDate(preset.verifiedAt)}</span>
        </p>
      )
    }
  </div>

  {
    options ? (
      <CompressIsland rule={options} kind={preset.kind} />
    ) : (
      <p class="card p-4">
        {FORMAT_LABEL[rule.format]} output isn't supported yet. Use the spec below with the{" "}
        <a href="/compress-image">image compressor</a>.
      </p>
    )
  }

  <section aria-labelledby="spec-heading" class="card mt-10 grid gap-3 p-4 sm:p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="spec-heading" class="text-lg">The spec</h2>
      <span class="font-mono text-xs text-muted">{preset.id}</span>
    </div>
    <dl class="facts text-sm">
      {
        dims && (
          <div>
            <dt>Size</dt>
            <dd>{dims}</dd>
          </div>
        )
      }
      <div>
        <dt>File size</dt>
        <dd>{size}</dd>
      </div>
      <div>
        <dt>Format</dt>
        <dd>{FORMAT_LABEL[rule.format]}</dd>
      </div>
      {
        bg && (
          <div>
            <dt>Background</dt>
            <dd class="capitalize">{bg}</dd>
          </div>
        )
      }
    </dl>
    <div class="grid gap-1 border-t border-border pt-3 text-muted text-sm">
      {
        preset.source ? (
          <p>
            Source: <a href={preset.source.url} rel="noopener noreferrer external">{preset.source.label}</a>
          </p>
        ) : (
          <p>Source: none we could confirm yet.</p>
        )
      }
      <p>
        {preset.verifiedAt ? `Last verified ${formatDate(preset.verifiedAt)}.` : "Not yet verified against an official notice."}{" "}
        <a href={reportRuleUrl(preset.title, preset.path)} rel="noopener noreferrer external">Spec changed? Tell us</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="about-heading" class="mt-10 grid max-w-prose gap-3">
    <h2 id="about-heading" class="text-lg">About this {preset.kind}</h2>
    {preset.notes && <p>{preset.notes}</p>}
    <p>
      Pick your {preset.kind} and it is cropped from the centre to {dims ?? "the required size"}{bg && `, placed on a ${bg} background,`}{" "}
      and compressed to {rule.minBytes === undefined ? `${maxBytesToKb(rule.maxBytes)} KB or less` : size}. Everything runs
      in your browser, so the file never leaves your device.
    </p>
    <p class="text-sm text-muted">
      Tip: crop your {preset.kind} roughly to shape first so the centre crop keeps what matters.
    </p>
  </section>
</Base>
