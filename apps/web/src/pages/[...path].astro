---
// Devanagari and Bengali faces: the browser fetches a file only when its script appears (unicode-range).
import "@fontsource-variable/noto-sans-devanagari/wght.css";
import "@fontsource-variable/noto-sans-bengali/wght.css";
import { presets, type Preset } from "@tools/presets";
import type { GetStaticPaths } from "astro";
import { StatusGlyph } from "../components/brand/StatusGlyph";
import CompressIsland from "../components/CompressIsland.astro";
import type { ToolSpec } from "../components/CompressTool";
import Base from "../layouts/Base.astro";
import { specIssueUrl } from "../lib/links";
import { countryName, dimensions, FORMAT_LABEL, formatDate, nativeCountry, ruleChecked, sizeRange } from "../lib/presets";
import { statedMaxKb } from "../lib/units";

export const getStaticPaths = (() =>
  presets.map((preset) => ({ params: { path: preset.path }, props: { preset } }))) satisfies GetStaticPaths;

interface Props {
  preset: Preset;
}

const { preset } = Astro.props;
const { output } = preset;
const dims = dimensions(preset);
const size = sizeRange(preset);
const path = `/${preset.path}`;
const bg = output.background && (/^#f{3}(f{3})?$/i.test(output.background) ? "white" : output.background);
const native = nativeCountry(preset.country);
const portal = preset.portal.replace(/\s*\(.*\)$/, "");

// The engine encodes JPEG and WebP only.
const spec: ToolSpec | null =
  output.format === "image/jpeg" || output.format === "image/webp"
    ? {
        format: output.format,
        maxBytes: output.maxBytes,
        ...(output.minBytes !== undefined && { minBytes: output.minBytes }),
        ...(output.width !== undefined && { width: output.width }),
        ...(output.height !== undefined && { height: output.height }),
        ...(output.background !== undefined && { background: output.background }),
      }
    : null;

const description = `Make your ${preset.title.toLowerCase()}: ${[dims, size].filter(Boolean).join(", ")}, ready to upload to ${portal}. It runs on your device, so nothing is uploaded.`;
const rows: [string, string][] = [
  ...(dims ? [["Width and height", dims] as [string, string]] : []),
  ["File size", size],
  ["Format", FORMAT_LABEL[output.format]],
  ...(bg ? [["Background", bg] as [string, string]] : []),
];
---

<Base title={preset.title} {description} path={path} section="forms">
  <nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap gap-1.5 text-[13px] text-muted-foreground">
    <a href="/" class="text-muted-foreground no-underline">Home</a><span aria-hidden="true">/</span>
    <a href="/#forms" class="text-muted-foreground no-underline">Forms</a><span aria-hidden="true">/</span>
    <span>
      {countryName(preset.country)}{" "}
      {native && <span class={native.script} lang={native.lang}>{native.name}</span>}
    </span>
  </nav>
  <h1 class="t-h1">{preset.title}</h1>
  <p class="mt-2 mb-4 flex flex-wrap gap-x-2.5 gap-y-1 text-[13px] text-muted-foreground md:mb-5">
    <span>For {portal}</span><span aria-hidden="true">·</span><span>{ruleChecked(preset)}</span>
    <span aria-hidden="true">·</span><span>Your {preset.kind} stays on this device</span>
  </p>

  {
    preset.verifiedAt === null && (
      <p class="mb-4 flex items-start gap-2.5 rounded-lg bg-sunk px-3.5 py-3 text-sm md:mb-5">
        <StatusGlyph status="unv" className="mt-px size-5 shrink-0 text-status-warn" />
        <span>
          <b>Not checked yet.</b> These numbers come from {preset.source ? preset.source.label.toLowerCase() : "no source we could confirm"}. Check your notice before you submit.
        </span>
      </p>
    )
  }

  {
    spec ? (
      <CompressIsland spec={spec} kind={preset.kind} verified={preset.verifiedAt !== null} />
    ) : (
      <p class="rounded-xl border border-line bg-card p-4">
        {FORMAT_LABEL[output.format]} files can't be made here yet. Use the size rule below with the{" "}
        <a href="/compress-image">image compressor</a>.
      </p>
    )
  }

  <div class="mt-10 grid items-start gap-8 border-t border-line pt-8 md:grid-cols-2">
    <section aria-labelledby="rule-h" class="rounded-xl border border-line bg-card p-4 md:p-5">
      <h2 id="rule-h" class="t-h3">The size rule</h2>
      <dl class="mt-2 text-sm">
        {
          rows.map(([k, v]) => (
            <div class="flex justify-between gap-4 border-b border-line py-2 last:border-b-0">
              <dt class="text-muted-foreground">{k}</dt>
              <dd class:list={["num text-right", k === "Background" && "capitalize"]} translate="no">{v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-2 grid gap-1 border-t border-line pt-3 text-[13px] text-muted-foreground">
        <p>
          Source:{" "}
          {preset.source ? (
            <a href={preset.source.url} rel="noopener noreferrer external">{preset.source.label}</a>
          ) : (
            "none we could confirm yet."
          )}
        </p>
        <p>{preset.verifiedAt ? `Checked ${formatDate(preset.verifiedAt)}.` : "Not checked against an official notice."}</p>
        <a class="inline-flex min-h-11 items-center text-sm font-[550]" href={specIssueUrl(preset.title, preset.path)} rel="noopener noreferrer external">
          Report a different rule
        </a>
      </div>
    </section>
    <section aria-labelledby="about-h" class="grid gap-3">
      <h2 id="about-h" class="t-h2">About this {preset.kind}</h2>
      {preset.notes && <p class="text-[15px] text-ink-2">{preset.notes}</p>}
      <p class="text-[15px] text-ink-2">
        Add your {preset.kind} and it is cropped from the centre to {dims ?? "the size the form asks for"}{bg && `, placed on a ${bg} background,`}{" "}
        and made {output.minBytes === undefined ? `${statedMaxKb(output.maxBytes)} KB or less` : size}. Your browser does all of it,
        so the file never leaves your device.
      </p>
      <p class="text-[13px] text-muted-foreground">Tip: crop your {preset.kind} roughly to shape first, so the centre crop keeps what matters.</p>
    </section>
  </div>
</Base>
