---
import { presets, type Preset } from "@tools/presets";
import type { GetStaticPaths } from "astro";
import CompressIsland from "../components/CompressIsland.astro";
import { IconAlert } from "../components/icons";
import SpecBadge from "../components/SpecBadge.astro";
import type { ToolSpec } from "../components/CompressTool";
import Base from "../layouts/Base.astro";
import { specIssueUrl } from "../lib/links";
import { formatBytes, statedMaxKb } from "../lib/units";
import { countryName, dimensions, FORMAT_LABEL, formatDate, sizeRange } from "../lib/presets";

export const getStaticPaths = (() =>
  presets.map((preset) => ({ params: { path: preset.path }, props: { preset } }))) satisfies GetStaticPaths;

interface Props {
  preset: Preset;
}

const { preset } = Astro.props;
const { output } = preset;
const dims = dimensions(preset);
const size = sizeRange(preset);
const path = `/${preset.path}`;
const bg = output.background && (/^#f{3}(f{3})?$/i.test(output.background) ? "white" : output.background);

// The engine encodes JPEG and WebP only.
const spec: ToolSpec | null =
  output.format === "image/jpeg" || output.format === "image/webp"
    ? {
        format: output.format,
        maxBytes: output.maxBytes,
        ...(output.minBytes !== undefined && { minBytes: output.minBytes }),
        ...(output.width !== undefined && { width: output.width }),
        ...(output.height !== undefined && { height: output.height }),
        ...(output.background !== undefined && { background: output.background }),
      }
    : null;

const description = `Make your ${preset.title.toLowerCase()}: ${[dims, size].filter(Boolean).join(", ")}, ready to upload to ${preset.portal.replace(/\s*\(.*\)$/, "")}. Runs on your device; nothing is uploaded.`;

// `output.fit` arrives with the preset-output change; until then photos fill, others fit.
const fit = (output as { fit?: "cover" | "contain" }).fit ?? (preset.kind === "photo" ? "cover" : "contain");
const target = dims ?? "the required size";
const placement =
  fit === "cover"
    ? `cropped to fill ${target}${bg ? ` on a ${bg} background` : ""}`
    : `fitted onto a ${bg ?? "white"} ${target} background, with nothing cut off`;
const exactBytes =
  output.minBytes === undefined
    ? `up to ${formatBytes(output.maxBytes)}`
    : `${output.minBytes.toLocaleString("en-US")}–${formatBytes(output.maxBytes)}`;
---

<Base title={preset.title} {description} path={path}>
  <nav aria-label="Breadcrumb" class="pb-3 text-sm text-muted">
    <a href="/">Tools</a> <span aria-hidden="true" class="px-1 text-faint">/</span> {countryName(preset.country)}
  </nav>
  <div class="grid gap-3 pb-6">
    <div class="grid gap-1">
      <h1 class="text-2xl sm:text-3xl">{preset.title}</h1>
      <p class="text-muted">For {preset.portal}.</p>
    </div>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <SpecBadge verifiedAt={preset.verifiedAt} />
      <span class="text-muted">
        {
          preset.verifiedAt === null
            ? "Check the official notice before you submit."
            : `Checked against the official notice on ${formatDate(preset.verifiedAt)}.`
        }
      </span>
    </p>
  </div>

  {
    spec ? (
      <CompressIsland spec={spec} kind={preset.kind} />
    ) : (
      <div class="alert alert-warning">
        <IconAlert />
        <p>
          {FORMAT_LABEL[output.format]} output isn't supported yet. Use the spec below with the{" "}
          <a href="/compress-image">image compressor</a>.
        </p>
      </div>
    )
  }

  <section aria-labelledby="spec-heading" class="card mt-10 grid gap-4 p-4 sm:p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="spec-heading" class="text-lg">The spec</h2>
      <span class="font-mono text-xs text-faint">{preset.id}</span>
    </div>
    <dl class="kv text-sm">
      {
        dims && (
          <div>
            <dt>Dimensions</dt>
            <dd>{dims}</dd>
          </div>
        )
      }
      <div>
        <dt>File size</dt>
        <dd>
          {size}
          <span class="block text-xs text-muted">{exactBytes}</span>
        </dd>
      </div>
      <div>
        <dt>Format</dt>
        <dd>{FORMAT_LABEL[output.format]}</dd>
      </div>
      {
        bg && (
          <div>
            <dt>Background</dt>
            <dd class="capitalize">{bg}</dd>
          </div>
        )
      }
      <div>
        <dt>Status</dt>
        <dd>
          {preset.verifiedAt ? `Verified ${formatDate(preset.verifiedAt)}` : "Unverified"}
        </dd>
      </div>
    </dl>
    <div class="grid gap-1 border-t border-border pt-4 text-sm text-muted">
      {
        preset.source ? (
          <p>
            Source: <a href={preset.source.url} rel="noopener noreferrer external">{preset.source.label}</a>
          </p>
        ) : (
          <p>Source: none we could confirm yet.</p>
        )
      }
      <p>
        Portal changed its rules?{" "}
        <a href={specIssueUrl(preset.title, preset.path)} rel="noopener noreferrer external">Report a spec change</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="about-heading" class="mt-12 grid max-w-prose gap-3">
    <h2 id="about-heading" class="text-lg">How your {preset.kind} is prepared</h2>
    <p>
      Your {preset.kind} is {placement}, then saved as {FORMAT_LABEL[output.format].replace(/\s*\(.*\)$/, "")} at{" "}
      {output.minBytes === undefined ? `${statedMaxKb(output.maxBytes)} KB or less` : size}. It all runs in your browser, so
      the file never leaves your device.
    </p>
    {preset.notes && <p class="text-muted">{preset.notes}</p>}
    {
      fit === "cover" && (
        <p class="text-sm text-muted">
          Tip: crop your {preset.kind} roughly to shape first so the parts that matter stay in frame.
        </p>
      )
    }
  </section>
</Base>
